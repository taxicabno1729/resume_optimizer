# Exa AI - Search API (https://exa.ai - 1000 free searches/month)
EXA_API_KEY=your_exa_api_key_here

# Browserbase - Cloud browser automation (https://browserbase.com)
BROWSERBASE_API_KEY=your_browserbase_api_key_here
BROWSERBASE_PROJECT_ID=your_browserbase_project_id_here

# LLM API key for Stagehand browser agent (OpenAI, Google, etc.)
MODEL_API_KEY=your_model_api_key_here

# Model to use for browser automation (default: google/gemini-2.0-flash)
STAGEHAND_MODEL=google/gemini-2.0-flash
